# SatuDapur — copy to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are baked in at BUILD time — after changing them,
# rebuild/redeploy (dev server picks them up on restart).

# Production domain, no trailing slash. Used for canonical/OG/sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://satudapur.id

# WhatsApp lead channel — international format, no + or dashes.
NEXT_PUBLIC_WHATSAPP=6281234567890

# Prefilled WhatsApp message (URL-encoded spaces are fine unencoded here).
NEXT_PUBLIC_WA_TEXT="Halo SatuDapur! Saya mau tahu lebih tentang POS untuk restoran saya."

# Google Apps Script Web App URL (doPost) — waiting-list form target.
# Deploy steps: see apps-script/Code.gs header comment.
# Leave empty for demo mode (form shows success but logs nothing).
NEXT_PUBLIC_APPS_SCRIPT_URL=
